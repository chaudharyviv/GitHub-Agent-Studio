# GitHub Agent Studio Configuration
# Copy this file to .env and fill in your values

# Required: OpenAI API Key
OPENAI_API_KEY=sk-...

# Optional: Override the LLM model (default: gpt-4o-mini)
# Keep this as gpt-4o-mini for cost efficiency
OPENAI_MODEL=gpt-4o-mini

# Optional: max tokens the model may write per call (2048 fits a full "Teach me" answer; model limit is 16384)
MAX_OUTPUT_TOKENS=2048

# Optional: GitHub Personal Access Token (recommended but not required)
# Using a token increases rate limits and allows access to private repos if needed
GITHUB_TOKEN=ghp_...
