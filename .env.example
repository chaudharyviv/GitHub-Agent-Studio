# GitHub Agent Studio Configuration
# Copy this file to .env and fill in your values

# Required: OpenAI API Key
OPENAI_API_KEY=sk-...

# Optional: Override the LLM model (default: gpt-4o-mini)
# Keep this as gpt-4o-mini for cost efficiency
OPENAI_MODEL=gpt-4o-mini

# Optional: max tokens the model may write per call (2048 fits a full "Teach me" answer; model limit is 16384)
MAX_OUTPUT_TOKENS=2048

# Optional: cheap test runs. Smaller tool results and fewer tool rounds (see agents/limits.py).
# Set to 1 while developing, remove for full-quality investigations.
LITE_MODE=0

# Optional: GitHub Personal Access Token (recommended but not required)
# Using a token increases rate limits and allows access to private repos if needed
GITHUB_TOKEN=ghp_...

# Optional: Tavily search API key (https://tavily.com)
# Enables the Security Specialist's search_cve tool (live CVE lookup, biased toward NVD / GitHub Advisories).
# Without it, search_cve returns a clear "unavailable" error and the specialist falls back to static heuristics only.
TAVILY_API_KEY=tvly-...

# Optional: where memory is kept. "sqlite" (default) persists to agent_memory.db across restarts.
# "memory" keeps everything in process memory only — forgotten when the app restarts. Use "memory" on
# Streamlit Cloud (or any host with a non-durable filesystem): a SQLite file there would just be a
# slower way to lose the same data, while making the app claim a persistence it cannot actually offer.
MEMORY_BACKEND=sqlite
